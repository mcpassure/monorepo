# Dockerfile.inttest — Testes integrados com blast real (binário nativo)
#
# Compila o blast DBC→CSV a partir do código-fonte (blast_main.c + zlib/contrib)
# e tenta baixar um DBC real do DATASUS para validar o pipeline completo.
#
# Build:  docker build -f Dockerfile.inttest -t mcp-cnes-inttest .
# Run:    docker run --rm mcp-cnes-inttest
# Ou:     docker compose -f docker-compose.inttest.yml up --build

# ── Stage 1: Compilar blast ─────────────────────────────────────────────────
FROM debian:bookworm-slim AS blast-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc wget ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Baixa blast.c + blast.h do zlib (domínio público, Mark Adler)
RUN wget -q \
    "https://raw.githubusercontent.com/madler/zlib/master/contrib/blast/blast.c" \
    "https://raw.githubusercontent.com/madler/zlib/master/contrib/blast/blast.h"

COPY 08_testes_integrados/binarios/scripts/blast_main.c .

RUN gcc -O2 -o blast blast_main.c blast.c && strip blast

# Smoke test: blast --version deve retornar sem erro
RUN ./blast --version

# ── Stage 2: Baixar DBC fixture do DATASUS (best-effort) ───────────────────
FROM debian:bookworm-slim AS dbc-fetcher

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates && rm -rf /var/lib/apt/lists/*

# Tenta baixar STSC202501.dbc (Estabelecimentos SC, competência Jan/2025).
# Se o servidor DATASUS estiver indisponível, continua sem fixture.
RUN mkdir -p /fixtures && \
    wget -q --timeout=30 --tries=2 \
      "http://ftp.datasus.gov.br/dissemin/publicos/CNES/200508_/Dados/ST/STSC202501.dbc" \
      -O /fixtures/STSC202501.dbc 2>/dev/null \
    && echo "✓ DBC fixture baixado: $(wc -c < /fixtures/STSC202501.dbc) bytes" \
    || (echo "⚠ DBC indisponível no build — FTP07 usará mock" \
        && rm -f /fixtures/STSC202501.dbc)

# ── Stage 3: Runner de testes ───────────────────────────────────────────────
FROM node:22-bookworm-slim AS test-runner

# Ferramentas de build para better-sqlite3 (addon nativo Node.js)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ && rm -rf /var/lib/apt/lists/*

# blast no PATH do sistema
COPY --from=blast-builder /build/blast /usr/local/bin/blast

# Fixture DBC (diretório sempre existe; o .dbc pode estar ausente)
COPY --from=dbc-fetcher /fixtures /opt/cnes-fixtures

WORKDIR /app

# Instalar dependências antes de copiar o código (melhor cache)
COPY package*.json ./
RUN npm ci

COPY . .

# Compilar TypeScript
RUN npm run build

# Confirmar que blast funciona no ambiente final
RUN blast --version

# Configurar fixture DBC se disponível e executar suíte
CMD ["sh", "-c", "\
  FIXTURE=/opt/cnes-fixtures/STSC202501.dbc; \
  if [ -f \"$FIXTURE\" ]; then \
    echo \"✓ DBC fixture disponível: $(wc -c < $FIXTURE) bytes — blast usará DBC real\"; \
    export VETRUM_DBC_FIXTURE=\"$FIXTURE\"; \
  else \
    echo \"⚠ DBC fixture não encontrado — FTP07 usará mock CSV (blast não validado com DBC real)\"; \
  fi; \
  npm run test:integration"]
